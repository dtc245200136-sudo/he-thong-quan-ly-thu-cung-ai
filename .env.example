# Loại cơ sở dữ liệu: mssql (SQL Server) hoặc sqlite
DB_TYPE=mssql

# Cấu hình SQL Server
SQLSERVER_SERVER=.\SQL2022
SQLSERVER_DATABASE=petcare_db
SQLSERVER_DRIVER=SQL Server
SQLSERVER_TRUSTED=yes
