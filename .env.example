# SQLSERVER_PASSWORD=your_password

# Bảo mật JWT
SECRET_KEY=petcare-secret-key-aia331-ictu-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings
DEFAULT_AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
